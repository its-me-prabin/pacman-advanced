{
  "name": "pacman-js",
  "version": "1.0.0",
  "description": "Pacman clone made with JavaScript, HTML, and CSS",
  "main": "build/app.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/bward2/pacman-js"
  },
  "keywords": ["pacman", "game", "javascript", "canvas", "arcade"],
  "author": "Brent Ward",
  "license": "MIT",
  "nyc": {
    "include": [
      "app/scripts/**/*.js"
    ],
    "exclude": [
      "app/tests/**/*.js"
    ],
    "all": true,
    "reporter": ["text", "html", "lcov"]
  },
  "scripts": {
    "test": "nyc --check-coverage --lines 100 --functions 100 --branches 100 mocha app/tests",
    "coverage": "nyc report --reporter=text-lcov | codecov",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --format json > lint-report.json 2>&1 || true",
    "update": "ncu -i --format group",
    "serve": "http-server -p 8080 -c-1",
    "build": "gulp build",
    "watch": "gulp watch",
    "build:prod": "NODE_ENV=production gulp build",
    "start": "npm run build && npm run serve",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "babel-loader": "^9.1.3",
    "codecov": "^3.8.3",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.0",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-concat": "^2.6.1",
    "gulp-csso": "^4.0.1",
    "gulp-remove-code": "^3.0.4",
    "gulp-sass": "^5.1.0",
    "gulp-terser": "^2.1.0",
    "http-server": "^14.1.1",
    "husky": "^8.0.3",
    "mocha": "^10.2.0",
    "npm-check-updates": "^16.14.12",
    "nyc": "^15.1.0",
    "sass": "^1.69.5",
    "sinon": "^17.0.1"
  }
}
